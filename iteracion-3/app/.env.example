# Servidor SMTP para el envío de asignaciones.
# Copia este archivo a .env y completa los valores.

# Ejemplo Gmail (con contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# SMTP_FROM="Amigo Secreto <tucorreo@gmail.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

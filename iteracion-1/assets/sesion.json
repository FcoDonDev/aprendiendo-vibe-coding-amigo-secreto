            "input": {
              "path": "/home/dev/fuentes/repo_blog_1/iteracion_1/glm-pago/index.html",
              "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>🎁 Amigo Secreto</title>\n<style>\n  :root {\n    --bg: #0f0e17;\n    --surface: #1a1825;\n    --surface-2: #232033;\n    --accent: #ff8906;\n    --accent-2: #f25f4c;\n    --text: #fffffe;\n    --text-soft: #a7a9be;\n    --ok: #3ddc97;\n    --radius: 14px;\n  }\n\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  body {\n    font-family: 'Segoe UI', system-ui, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 2rem 1rem 4rem;\n  }\n\n  header { text-align: center; margin-bottom: 2rem; }\n  header h1 { font-size: 2.2rem; letter-spacing: 1px; }\n  header p  { color: var(--text-soft); margin-top: .4rem; }\n\n  .container {\n    width: 100%;\n    max-width: 720px;\n    display: grid;\n    gap: 1.5rem;\n  }\n\n  .card {\n    background: var(--surface);\n    border: 1px solid #2a2740;\n    border-radius: var(--radius);\n    padding: 1.5rem;\n    box-shadow: 0 8px 24px rgba(0,0,0,.35);\n  }\n  .card h2 {\n    font-size: 1.05rem;\n    margin-bottom: 1rem;\n    color: var(--accent);\n    text-transform: uppercase;\n    letter-spacing: 2px;\n  }\n\n  /* --- Formulario de participantes --- */\n  form { display: flex; gap: .7rem; }\n  input[type=\"text\"] {\n    flex: 1;\n    padding: .8rem 1rem;\n    border: 1px solid #3a3655;\n    border-radius: 10px;\n    background: var(--surface-2);\n    color: var(--text);\n    font-size: 1rem;\n    outline: none;\n    transition: border-color .2s;\n  }\n  input[type=\"text\"]:focus { border-color: var(--accent); }\n\n  button {\n    cursor: pointer;\n    border: none;\n    border-radius: 10px;\n    font-size: 1rem;\n    font-weight: 600;\n    padding: .8rem 1.3rem;\n    transition: transform .1s, filter .2s;\n  }\n  button:active { transform: scale(.96); }\n\n  .btn-primary { background: var(--accent); color: #1a1825; }\n  .btn-primary:hover { filter: brightness(1.1); }\n  .btn-outline {\n    background: transparent;\n    color: var(--text-soft);\n    border: 1px solid #3a3655;\n  }\n  .btn-outline:hover { color: var(--text); border-color: var(--accent); }\n  .btn-danger {\n    background: transparent;\n    color: var(--accent-2);\n    border: 1px solid #4a2626;\n  }\n  .btn-danger:hover { background: #2a181d; }\n\n  /* --- Lista de participantes --- */\n  ul { list-style: none; display: grid; gap: .55rem; }\n  li.participante {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    background: var(--surface-2);\n    border-radius: 10px;\n    padding: .7rem 1rem;\n    animation: appear .25s ease;\n  }\n  li.participante span.nombre { font-weight: 600; }\n  .chip-q {\n    background: #2a2740;\n    color: var(--text-soft);\n    border-radius: 8px;\n    padding: .2rem .6rem;\n    font-size: .8rem;\n    margin-left: .6rem;\n  }\n  .acciones { display: flex; gap: .4rem; align-items: center; }\n  .btn-x {\n    background: none;\n    color: var(--text-soft);\n    font-size: 1.1rem;\n    padding: .2rem .5rem;\n  }\n  .btn-x:hover { color: var(--accent-2); }\n\n  .vacio { color: var(--text-soft); text-align: center; padding: 1rem 0; font-style: italic; }\n\n  /* --- Sorteo --- */\n  .zona-sorteo { display: flex; flex-direction: column; gap: 1rem; align-items: center; }\n  #btn-sorteo {\n    font-size: 1.15rem;\n    padding: 1rem 2.5rem;\n    border-radius: 999px;\n    width: 100%;\n  }\n  #btn-sorteo:disabled { opacity: .4; cursor: not-allowed; }\n\n  .excluidos {\n    display: flex;\n    flex-wrap: wrap;\n    gap: .5rem;\n    justify-content: center;\n    width: 100%;\n  }\n  .excluidos select {\n    background: var(--surface-2);\n    color: var(--text);\n    border: 1px solid #3a3655;\n    border-radius: 8px;\n    padding: .45rem .6rem;\n    font-size: .9rem;\n  }\n\n  /* --- Resultados --- */\n  .grid-resultados {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n    gap: .8rem;\n  }\n  .tarjeta {\n    position: relative;\n    height: 110px;\n    border-radius: 12px;\n    overflow: hidden;\n    cursor: pointer;\n    perspective: 600px;\n  }\n  .cara {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    border-radius: 12px;\n    padding: .6rem;\n    text-align: center;\n    transition: transform .5s, opacity .5s;\n    backface-visibility: hidden;\n  }\n  .cara-frontal {\n    background: linear-gradient(135deg, #4a2c6d, #2d2150);\n    border: 2px dashed #7b5ea7;\n    color: var(--text-soft);\n    font-size: .95rem;\n    gap: .3rem;\n  }\n  .cara-frontal .emoji { font-size: 1.8rem; }\n  .cara-trasera {\n    background: var(--accent);\n    color: #1a1825;\n    transform: rotateY(180deg);\n    justify-content: center;\n  }\n  .cara-trasera .de   { font-size: .75rem; opacity: .75; }\n  .cara-trasera .para { font-size: 1.15rem; font-weight: 800; }\n  .tarjeta.revelada .cara-frontal { transform: rotateY(180deg); opacity: 0; }\n  .tarjeta.revelada .cara-trasera { transform: rotateY(0); opacity: 1; }\n\n  .mensaje {\n    min-height: 1.4rem;\n    text-align: center;\n    color: var(--text-soft);\n    font-size: .95rem;\n  }\n  .mensaje.error   { color: var(--accent-2); }\n  .mensaje.exito   { color: var(--ok); }\n\n  .nota { color: var(--text-soft); font-size: .85rem; text-align: center; }\n\n  @keyframes appear { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; } }\n\n  @media (max-width: 520px) {\n    form { flex-direction: column; }\n    header h1 { font-size: 1.7rem; }\n  }\n</style>\n</head>\n<body>\n\n<header>\n  <h1>🎁 Amigo Secreto</h1>\n  <p>Agrega a los participantes, sortea y descubre quién regala a quién.</p>\n</header>\n\n<div class=\"container\">\n\n  <!-- Participantes -->\n  <section class=\"card\">\n    <h2>Participantes</h2>\n    <form id=\"form-participante\" autocomplete=\"off\">\n      <input type=\"text\" id=\"input-nombre\" placeholder=\"Nombre del participante\" maxlength=\"40\" required>\n      <button class=\"btn-primary\" type=\"submit\">+ Agregar</button>\n    </form>\n    <div id=\"lista-participantes\" style=\"margin-top: 1rem;\"></div>\n  </section>\n\n  <!-- Sorteo -->\n  <section class=\"card\">\n    <h2>Sorteo</h2>\n    <div class=\"zona-sorteo\">\n      <div class=\"excluidos\" id=\"zona-exclusiones\" hidden>\n        <!-- Exclusiones dinámicas -->\n      </div>\n      <p class=\"nota\" id=\"nota-exclusiones\" hidden>\n        Si两 personas no deben salir juntas, excluye una a la otra aquí 👇\n      </p>\n      <button id=\"btn-sorteo\" class=\"btn-primary\" disabled>🎲 Sortear</button>\n      <p class=\"mensaje\" id=\"mensaje-sorteo\">Necesitas al menos 2 participantes para sortear.</p>\n    </div>\n  </section>\n\n  <!-- Resultados -->\n  <section class=\"card\" id=\"card-resultados\" hidden>\n    <h2>Resultados — toca cada tarjeta para revelarla</h2>\n    <div class=\"grid-resultados\" id=\"grid-resultados\"></div>\n    <div style=\"margin-top: 1.2rem; display: flex; gap: .7rem; justify-content: center; flex-wrap: wrap;\">\n      <button class=\"btn-outline\" id=\"btn-ocultar-todas\">🙈 Ocultar todas</button>\n      <button class=\"btn-outline\" id=\"btn-revelar-todas\">🎉 Revelar todas</button>\n      <button class=\"btn-danger\" id=\"btn-reset\">🗑️ Borrar sorteo</button>\n    </div>\n  </section>\n\n</div>\n\n<script>\n(() => {\n  'use strict';\n\n  const LS_LISTA = 'amigoSecreto.participantes.v1';\n  const LS_RES   = 'amigoSecreto.resultados.v1';\n\n  let participantes = cargar(LS_LISTA, []);\n  let resultado     = cargar(LS_RES, null); // Map<giver → receiver>\n  let exclusions    = [];                   // pares [a, b] que no pueden salir juntos\n\n  // ---------- Utilidades ----------\n  function cargar(clave, porDefecto) {\n    try {\n      const v = JSON.parse(localStorage.getItem(clave));\n      return v ?? porDefecto;\n    } catch { return porDefecto; }\n  }\n  function guardar(clave, valor) {\n    localStorage.setItem(clave, JSON.stringify(valor));\n  }\n  function formatear(n) {\n    return n.toLowerCase().replace(/\\s+/g, ' ').trim();\n  }\n\n  // ---------- Referencias DOM ----------\n  const $ = (sel) => document.querySelector(sel);\n  const formParticipante = $('#form-participante');\n  const inputNombre      = $('#input-nombre');\n  const contLista        = $('#lista-participantes');\n  const btnSorteo        = $('#btn-sorteo');\n  const msgSorteo        = $('#mensaje-sorteo');\n  const cardResultados   = '#card-resultados';\n  const gridResultados   = $('#grid-resultados');\n  const zonaExclusiones  = $('#zona-exclusiones');\n  const notaExclusiones  = $('#nota-exclusiones');\n\n  // ---------- Render: lista de participantes ----------\n  function renderLista() {\n    contLista.innerHTML = '';\n    if (participantes.length === 0) {\n      contLista.innerHTML = '<p class=\"vacio\">Aún no hay participantes. ¡Agrega el primero!</p>';\n    } else {\n      const ul = document.createElement('ul');\n      participantes.forEach((nombre) => {\n        const li = document.createElement('li');\n        li.className = 'participante';\n        li.innerHTML = `<span class=\"nombre\">👤 <b>${esc(nombre)}</b></span>`;\n        const acciones = document.createElement('div');\n        acciones.className = 'acciones';\n        const btnX = document.createElement('button');\n        btnX.className = 'btn-x';\n        btnX.title = 'Eliminar';\n        btnX.textContent = '✕';\n        btnX.addEventListener('click', () => eliminar(nombre));\n        acciones.appendChild(btnX);\n        li.appendChild(acciones);\n        ul.appendChild(li);\n      });\n      contLista.appendChild(ul);\n    }\n    actualizarEstado();\n  }\n\n  function esc(s) {\n    return s.replace(/[&<>\"']/g, c => ({\n      '&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'\n    }[c]));\n  }\n\n  function eliminar(nombre) {\n    participantes = participantes.filter(p => p !== nombre);\n    exclusions = exclusions.filter(([a, b]) => a !== nombre && b !== nombre);\n    if (resultado && resultado[nombre] !== undefined) resultado = null;\n    guardar(LS_LISTA, participantes);\n    guardar(LS_RES, resultado);\n    renderLista();\n  }\n\n  // ---------- Agregar participante ----------\n  formParticipante.addEventListener('submit', (e) => {\n    e.preventDefault();\n    const nombre = inputNombre.value.trim();\n    if (!nombre) return;\n\n    if (participantes.some(p => formatear(p) === formatear(nombre))) {\n      mostrarM('⚠️ Ese participante ya está en la lista.', 'error');\n      return;\n    }\n    participantes.push(nombre);\n    guardar(LS_LISTA, participantes);\n    inputNombre.value = '';\n    inputNombre.focus();\n    mostrarM('');\n    renderLista();\n  });\n\n  function mostrarM(texto, tipo = '') {\n    msgSorteo.textContent = texto;\n    msgSorteo.className = 'mensaje ' + tipo;\n  }\n\n  // ---------- Estado del botón de sorteo ----------\n  function actualizarEstado() {\n    btnSorteo.disabled = participantes.length < 2;\n    if (participantes.length < 2) {\n      mostrarM('Necesitas al menos 2 participantes para sortear.');\n    } else if (msgSorteo.classList.contains('error') || !msgSorteo.textContent) {\n      mostrarM(`Listo para sortear con ${participantes.length} participantes. 🎲`);\n    }\n    renderExclusiones();\n  }\n\n  // ---------- Exclusiones (parejas que no deben tocarse) ----------\n  function renderExclusiones() {\n    zonaExclusiones.innerHTML = '';\n    if (participantes.length < 2) {\n      zonaExclusiones.hidden = true;\n      notaExclusiones.hidden = true;\n      return;\n    }\n    zonaExclusiones.hidden = false;\n    notaExclusiones.hidden = false;\n\n    participantes.forEach((p, i) => {\n      const sels = document.createElement('div');\n      sels.style.cssText = 'display:flex;gap:.4rem;align-items:center;background:var(--surface-2);padding:.4rem .6rem;border-radius:10px;';\n\n      const select = document.createElement('select');\n      select.innerHTML = '<option value=\"\">— no excluye a nadie —</option>' +\n        participantes\n          .filter(q => q !== p)\n          .map(q => `<option value=\"${esc(q)}\">${esc(q)}</option>`)\n          .join('');\n      select.value = exclusionesDe(p);\n      select.addEventListener('change', () => {\n        // quitar exclusiones previas de p, poner la nueva\n        exclusions = exclusions.filter(([a, b]) => a !== p && b !== p);\n        if (select.value) exclusions.push([p, select.value]);\n        if (resultado) { resultado = null; guardar(LS_RES, null); }\n        renderExclusiones();\n      });\n\n      sels.innerHTML = `<span style=\"font-size:.85rem\">${esc(recortar(p, 12))}</span>`;\n      sels.appendChild(select);\n      zonaExclusiones.appendChild(sels);\n    });\n  }\n\n  function recortar(s, n) { return s.length > n ? s.slice(0, n) + '…' : s; }\n\n  function exclusionesDe(p) {\n    const dup = exclusions.filter(([a, b]) => a === p || b === p);\n    return dup.length === 1 ? (dup[0][0] === p ? dup[0][1] : dup[0][0]) : '';\n  }\n\n  // ---------- Algoritmo de sorteo ----------\n  function sortear() {\n    const dom = participantes.slice();\n    const n = dom.length;\n\n    // Intentos aleatorios (max 400) respetando exclusiones y sin autoasignación\n    for (let intento = 0; intento < 400; intento++) {\n      const mezcla = FisherYates(dom.slice());\n      if (esValido(dom, mezcla)) {\n        return Object.fromEntries(dom.map((d, i) => [d, mezcla[i]]));\n      }\n    }\n    // Fallback determinista: rotar la lista\n    // (rota 1 posición, garantiza que nadie se asigne a sí mismo,\n    //  aunque puede violar una exclusión en casos extremos)\n    const rotada = dom.slice(1).concat(dom[0]);\n    return Object.fromEntries(dom.map((d, i) => [d, rotada[i]]));\n  }\n\n  function FisherYates(arr) {\n    for (let i = arr.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [arr[i], arr[j]] = [arr[j], arr[i]];\n    }\n    return arr;\n  }\n\n  function esValido(dadores, receptores) {\n    for (let i = 0; i < dadores.length; i++) {\n      if (dadores[i] === receptores[i]) return false;\n      if (excluidos(dadores[i], receptores[i])) return false;\n    }\n    return true;\n  }\n\n  function excluidos(a, b) {\n    return exclusions.some(([x, y]) =>\n      (x === a && y === b) || (x === b && y === a));\n  }\n\n  // ---------- Render de resultados ----------\n  function renderResultados() {\n    const card = $(cardResultados);\n    if (!resultado) { card.hidden = true; return; }\n    card.hidden = false;\n\n    gridResultados.innerHTML = '';\n    Object.entries(resultado).forEach(([de, para]) => {\n      const t = document.createElement('div');\n      t.className = 'tarjeta';\n      t.innerHTML = `\n        <div class=\"cara cara-frontal\">\n          <span class=\"emoji\">🎁</span>\n          <span>${esc(de)}</span>\n          <span style=\"font-size:.75rem\">toca para revelar</span>\n        </div>\n        <div class=\"cara cara-trasera\">\n          <span class=\"de\">🤫 puede decirse en secreto</span>\n          <span class=\"para\">${esc(de)} → ${esc(para)}</span>\n        </div>\n      `;\n      // Revealed state saved per session (not persisted, so secrets stay hidden by default)\n      t.addEventListener('click', () => t.classList.toggle('revelada'));\n      gridResultados.appendChild(t);\n    });\n  }\n\n  function ocultarTodas() {\n    gridResultados.querySelectorAll('.tarjeta').forEach(t => t.classList.remove('revelada'));\n  }\n  function revelarTodas() {\n    gridResultados.querySelectorAll('.tarjeta').forEach(t => t.classList.add('revelada'));\n  }\n\n  // ---------- Eventos de sorteo ----------\n  btnSorteo.addEventListener('click', () => {\n    if (participantes.length < 2) return;\n    const res = sortear();\n    resultado = res;\n    guardar(LS_RES, resultado);\n    mostrarM('🎉 ¡Sorteo realizado! Toca las tarjetas para revelar.', 'exito');\n    renderResultados();\n    renderExclusiones();\n  });\n\n  $('#btn-ocultar-todas').addEventListener('click', ocultarTodas);\n  $('#btn-revelar-todas').addEventListener('click', revelarTodas);\n\n  $('#btn-reset').addEventListener('click', () => {\n    resultado = null;\n    guardar(LS_RES, null);\n    ocultarTodas();\n    renderResultados();\n    mostrarM(`Listo para sortear con ${participantes.length} participantes. 🎲`);\n  });\n\n  // ---------- Init ----------\n  renderLista();\n  renderResultados();\n})();\n</script>\n\n</body>\n</html>\n"
            },

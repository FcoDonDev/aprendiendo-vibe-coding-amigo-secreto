# Copia este archivo como .env y rellena tus credenciales.
# Para Gmail: activa la verificación en dos pasos y crea una
# "Contraseña de aplicación" en https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
# Remitente que verán los participantes (por defecto, SMTP_USER)
MAIL_FROM="Amigo Secreto <tucorreo@gmail.com>"

# Puerto del servidor web
PORT=3000

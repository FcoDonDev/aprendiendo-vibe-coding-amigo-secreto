# Copia este archivo a .env.local y completa los valores SMTP.

# Servidor SMTP, p. ej. smtp.tuproveedor.com
SMTP_HOST=

# Puerto del servidor (587 para STARTTLS, 465 para TLS implícito)
SMTP_PORT=587

# Credenciales (opcional si tu servidor no exige autenticación)
SMTP_USER=
SMTP_PASS=

# Remitente que verán los destinatarios, p. ej. "Amigo Secreto <sorteo@tuproveedor.com>"
# Si se omite, se usa SMTP_USER.
SMTP_FROM=
